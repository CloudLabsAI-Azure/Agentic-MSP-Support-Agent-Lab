flowchart LR
  tech([Technician<br/>Senior or Tier 1])

  subgraph foundry[Microsoft Foundry project]
    agent[Support agent<br/>gpt-5.4-mini<br/>own Entra Agent ID]
    conn[OAuth connection<br/>servicedesk-mcp]
  end

  subgraph azure[Team resource group]
    search[(Azure AI Search<br/>knowledge index)]
    apim[API Management<br/>validates the user token]
    aca[Container Apps<br/>MCP server]
    mi[Managed identity<br/>id-mcp]
    kv[(Key Vault<br/>gateway key)]
    acr[(Container Registry)]
    subgraph monitor[Azure Monitor]
      appi[Application Insights]
      law[(Log Analytics)]
    end
  end

  subgraph power[Power Platform]
    app[Service Desk app]
    dv[(Dataverse<br/>roles, column security, audit)]
  end

  purview[Microsoft Purview<br/>DLP and labels]

  subgraph build[Lab VM]
    repo[(MCP server source<br/>already cloned)]
    tools[VS Code, Azure CLI, git]
  end

  tech --> agent
  tech --> app
  agent -->|knowledge| search
  agent -->|MCP tools| conn
  conn -->|technician's token<br/>ServiceDesk.Access| apim
  apim -->|gateway key, user,<br/>correlation ID| aca
  aca -->|runs as| mi
  mi -.->|reads key at startup| kv
  mi -->|on behalf of the technician| dv
  aca -->|checks results| purview
  app --> dv
  repo -->|edit| tools
  tools -->|az acr build| acr
  acr -->|image| aca
  agent -.->|traces| appi
  apim -.->|logs| law
  aca -.->|logs| law
  kv -.->|audit log| law

  classDef person fill:#ffffff,stroke:#5c5c5c,color:#1b1b1b
  classDef ai fill:#e8f1fb,stroke:#0f6cbd,color:#0b3a66
  classDef gate fill:#fdf3e6,stroke:#c46a00,color:#5c3200
  classDef data fill:#eef7ee,stroke:#2e7d32,color:#1b4d1f
  classDef identity fill:#f3eefb,stroke:#6b3fa0,color:#3b2160
  classDef ops fill:#f2f2f2,stroke:#6e6e6e,color:#2b2b2b
  class tech person
  class agent,search,conn ai
  class apim,aca,acr gate
  class app,dv,purview data
  class mi,kv identity
  class appi,law,tools,repo ops
